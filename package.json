{
  "name": "color-alchemy",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "build-dev": "rollup -c && node postbuild.mjs",
    "build-director": "rollup -c && node postbuild.mjs",
    "check": "tsc --noEmit",
    "prebuild": "npm run check",
    "postbuild": "node postbuild.mjs",
    "roadroller-optimize": "node tools/find-rr-config.mjs",
    "fn-order-optimize": "node tools/find-fn-order.mjs",
    "build-visualizer": "node tools/build-visualizer.mjs",
    "fouc-check": "node tools/fouc-probe.mjs",
    "css-diff": "node tools/css-diff.mjs",
    "music-check": "node tools/music-probe.mjs",
    "audio-bench": "node tools/audio-bench.mjs",
    "mobile-check": "node tools/responsive-probe.mjs",
    "phone": "node tools/phone.mjs",
    "start": "rollup -c -w",
    "test": "node check.mjs",
    "emoji-font": "node tools/emoji-font.mjs"
  },
  "devDependencies": {
    "@ampproject/rollup-plugin-closure-compiler": "^0.27.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "advzip-bin": "^2.0.0",
    "cssnano": "^7.1.9",
    "cssnano-preset-advanced": "^7.0.16",
    "ect-bin": "^1.4.1",
    "eslint": "^8.57.1",
    "google-closure-compiler": "^20260218.0.0",
    "harfbuzzjs": "^1.6.1",
    "html-minifier-next": "^5.1.3",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "qrcode": "^1.5.4",
    "roadroller": "file:../roadroller",
    "rollup": "^4.30.0",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.0",
    "wawoff2": "^2.0.1"
  },
  "overrides": {
    "@ampproject/rollup-plugin-closure-compiler": {
      "google-closure-compiler": "20210808.0.0"
    }
  }
